# Funmite POS — configuration template.
# Copy to .env and adjust. NEVER commit .env.

# Paths (relative to the project root unless absolute)
FUNMITE_DATA_DIR=
FUNMITE_LOG_DIR=
FUNMITE_BACKUP_DIR=

# Logging
FUNMITE_LOG_LEVEL=INFO

# Thermal receipt printer (Phase 12-F5). Fallback name used when the Settings
# UI has not configured a printer. The Settings UI choice takes precedence.
FUNMITE_PRINTER_NAME=

# API / local service (used in later phases)
FUNMITE_API_HOST=127.0.0.1
FUNMITE_API_PORT=8000

# Cloud sync settings (Phase 10C / two-PC)
FUNMITE_CLOUD_SYNC=false
# FUNMITE_CLOUD_DB_URL=
# FUNMITE_SYNC_PUSH_INTERVAL=30
# FUNMITE_SYNC_PULL_INTERVAL=60

# Backup retention. After each backup the newest keep backups are always
# retained and backups older than max age days are removed (both must apply).
# Set a value to 0 to disable that rule.
FUNMITE_BACKUP_KEEP=30
FUNMITE_BACKUP_MAX_AGE_DAYS=90

# Initial development accounts. If unset, the seed uses the documented
# development defaults (admin/admin123, cashier/cashier123). Set real values
# before production use.
# FUNMITE_SEED_ADMIN_USERNAME=
# FUNMITE_SEED_ADMIN_PASSWORD=
# FUNMITE_SEED_CASHIER_USERNAME=
# FUNMITE_SEED_CASHIER_PASSWORD=
